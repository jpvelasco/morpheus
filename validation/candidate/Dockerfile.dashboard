FROM node:22.17.1-alpine3.22@sha256:99351363debf40f3495cb7fc657a777334c3b21143e594dbfcc7de187439633c AS build

ARG SOURCE_DATE_EPOCH
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN --mount=type=bind,source=npm-cache,target=/npm-cache,ro \
    npm ci --offline --ignore-scripts --cache /npm-cache
COPY web/ ./
RUN npm run build \
    && find /build/dist -exec touch -h -d "@${SOURCE_DATE_EPOCH}" '{}' +

FROM python:3.12-alpine3.23@sha256:601d3d3797e90e2534782e69c85fafb7971b43f24c7b1b079b7e48dd435e458d

ARG MORPHEUS_VERSION
ARG SOURCE_COMMIT
ARG SOURCE_CREATED
ARG SOURCE_DATE_EPOCH

ENV PATH=/opt/morpheus/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MORPHEUS_DASHBOARD_DIR=/app/web

LABEL org.opencontainers.image.title="Morpheus dashboard" \
      org.opencontainers.image.version="${MORPHEUS_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.created="${SOURCE_CREATED}"

RUN addgroup -S morpheus \
    && adduser -S -D -H -G morpheus morpheus \
    && touch -h -d "@${SOURCE_DATE_EPOCH}" \
      /etc/group /etc/gshadow /etc/passwd /etc/shadow
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse,ro \
    cd /wheelhouse \
    && sha256sum --check SHA256SUMS \
    && python -m venv /opt/morpheus \
    && /opt/morpheus/bin/pip install \
      --no-cache-dir --no-compile --no-index --find-links=/wheelhouse \
      "morpheus-control-plane==${MORPHEUS_VERSION}" \
    && find /opt/morpheus -exec touch -h -d "@${SOURCE_DATE_EPOCH}" '{}' +

WORKDIR /app
COPY --from=build /build/dist ./web
USER morpheus
EXPOSE 7401
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7401/healthz', timeout=2)"]
CMD ["morpheus-dashboard"]
