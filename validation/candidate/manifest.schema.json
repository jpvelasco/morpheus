{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "candidate_version", "source_commit", "source_tree_clean", "source_date_epoch", "created_at", "tool_lock_sha256", "artifacts"],
  "properties": {
    "format": {"const": 1},
    "candidate_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_tree_clean": {"const": true},
    "source_date_epoch": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "tool_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type", "sha256", "size", "source_commit"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string", "pattern": "^payload/"},
          "media_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
        }
      }
    }
  }
}
