# ubuntu-1 operator environment for Morpheus control plane only.
# Copy to the runtime root as morpheus.env (mode 0600). Never commit secrets.
#
# Hard rules:
# - Do not point lifecycle at external services for mutation.
# - Do not restart, reconfigure, or replace coder-model or Open WebUI.
# - Container data always uses /var/lib/morpheus (set in deploy/compose.yaml).

MORPHEUS_PROJECT_ID=morpheus
MORPHEUS_BIND_ADDRESS=127.0.0.1
MORPHEUS_API_PORT=7400
MORPHEUS_DASHBOARD_PORT=7401
MORPHEUS_AGENT_PORT=7402
MORPHEUS_TELEMETRY_PORT=7410

# Candidate image tags after docker load (install.sh fills these when known).
# These deployed artifacts retain the pre-publication build ID aa7174aff319;
# its email-rewritten source equivalent is fa5fe3ca2e39.
MORPHEUS_BACKEND_IMAGE=morpheus/backend:0.1.0-aa7174aff319
MORPHEUS_DASHBOARD_IMAGE=morpheus/dashboard:0.1.0-aa7174aff319

# External inference (owned elsewhere). Read-only consumption only.
MORPHEUS_LLM_BASE_URL=http://coder-model:8000/v1
MORPHEUS_LLM_MODEL=qwen36-27b-nvfp4
MORPHEUS_EXTERNAL_DOCKER_NETWORK=ai_default
# Set only if the external endpoint requires a key; never log this value.
MORPHEUS_UPSTREAM_API_KEY=

# Secrets: generate with openssl rand -hex 32 (install.sh does this once).
MORPHEUS_API_KEY=
MORPHEUS_AGENT_KEY=
MORPHEUS_SESSION_SECRET=
MORPHEUS_SESSION_COOKIE_SECURE=true
MORPHEUS_SESSION_TTL_SECONDS=900

# Host runtime agent (GPU/disk/memory for the dashboard).
# install.sh sets socket path under the runtime root.
MORPHEUS_RUNTIME_AGENT_URL=
MORPHEUS_RUNTIME_AGENT_SOCKET=
MORPHEUS_AGENT_SOCKET_DIR=
MORPHEUS_AGENT_GID=

# Lifecycle remains off for ordinary ubuntu-1 operator use.
MORPHEUS_ENABLE_LIFECYCLE=false
MORPHEUS_LIFECYCLE_DEPLOYMENT_ROOT=
MORPHEUS_LIFECYCLE_LAB_AUTHORIZED=false

# Optional sidecars stay off for the ubuntu-1 operator stop-line.
MORPHEUS_ENABLE_SEARCH=false
MORPHEUS_ENABLE_VOICE=false
MORPHEUS_ENABLE_TELEMETRY=false
MORPHEUS_ENABLE_WORKFLOWS=false
MORPHEUS_ENABLE_RESEARCH=false
MORPHEUS_ENABLE_IMAGE_GENERATION=false
