{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "specification", "requirements"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "specification": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "status",
          "owning_tests",
          "risk",
          "required_environments",
          "requires_live_evidence",
          "requires_hardware_evidence",
          "first_satisfying_version",
          "evidence_manifests",
          "implementation_tasks"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
          "phase": {"type": "integer", "minimum": 0, "maximum": 10},
          "status": {"enum": ["planned", "implemented", "validated", "deferred"]},
          "owning_tests": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(tests|web/tests)/"}
          },
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "required_environments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["DEV", "VM", "HOST-RO", "HOST-MAINT"]}
          },
          "requires_live_evidence": {"type": "boolean"},
          "requires_hardware_evidence": {"type": "boolean"},
          "first_satisfying_version": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            ]
          },
          "evidence_manifests": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^artifacts/release-validation/.+/manifest\\.json$"}
          },
          "implementation_tasks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^IMP-[A-Z]+-[0-9]{3}-[0-9]{2}$"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "validated"}}},
            "then": {"properties": {"evidence_manifests": {"minItems": 1}}}
          }
        ]
      }
    }
  }
}
