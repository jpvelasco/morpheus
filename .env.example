# Morpheus owns only its control plane and optional sidecars.
MORPHEUS_BIND_ADDRESS=127.0.0.1
MORPHEUS_API_PORT=7400
MORPHEUS_DASHBOARD_PORT=7401
MORPHEUS_AGENT_PORT=7402
MORPHEUS_TELEMETRY_PORT=7410
MORPHEUS_N8N_PORT=7411
MORPHEUS_RESEARCH_PORT=7412
MORPHEUS_DATA_DIR=./data

# Existing inference service. This service is external and must not be mutated.
MORPHEUS_LLM_BASE_URL=http://history-coder:8000/v1
MORPHEUS_LLM_MODEL=qwen36-27b-nvfp4
MORPHEUS_EXTERNAL_DOCKER_NETWORK=ai_default

# Secrets must be generated locally and placed in .env, never committed.
MORPHEUS_API_KEY=
MORPHEUS_AGENT_KEY=
MORPHEUS_SESSION_SECRET=
MORPHEUS_UPSTREAM_API_KEY=
MORPHEUS_N8N_ENCRYPTION_KEY=

# Optional feature flags. Defaults remain false until their delivery phase exits.
MORPHEUS_ENABLE_SEARCH=false
MORPHEUS_ENABLE_VOICE=false
MORPHEUS_ENABLE_TELEMETRY=false
MORPHEUS_ENABLE_WORKFLOWS=false
MORPHEUS_ENABLE_RESEARCH=false
MORPHEUS_ENABLE_IMAGE_GENERATION=false
