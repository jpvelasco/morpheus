# Deny every path by default. Re-include only inputs consumed by the two
# production Dockerfiles and the LAB-002 context-equivalence proof.
**
!.dockerignore
!README.md
!pyproject.toml
!src/
!src/**
src/**/__pycache__/
src/**/__pycache__/**
src/**/*.py[cod]
!deploy/
deploy/**
!deploy/Dockerfile
!web/
web/**
!web/Dockerfile
!web/index.html
!web/package-lock.json
!web/package.json
!web/src/
!web/src/**
!web/tsconfig.app.json
!web/tsconfig.json
!web/tsconfig.node.json
!web/vite.config.ts
!validation/
validation/**
!validation/docker-context/
validation/docker-context/**
!validation/docker-context/Dockerfile
